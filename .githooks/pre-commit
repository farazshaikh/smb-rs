#!/usr/bin/env bash
# Pre-commit hook: blocks the commit unless `cargo check --workspace` passes.
#
# Installed via `git config core.hooksPath .githooks` (see README.md).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] cargo check --workspace"
if ! cargo check --workspace; then
    echo "[pre-commit] cargo check failed -- commit aborted." >&2
    exit 1
fi
